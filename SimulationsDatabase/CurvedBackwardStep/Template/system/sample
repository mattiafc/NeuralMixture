FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      sample;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


type            sets;
libs            (sampling);

writeControl    onEnd;

interpolationScheme cellPoint;

setFormat       raw;

fields          (k k_Frozen U U_Frozen turbulenceProperties:devReff bijDelta bijDeltaFrozen p);

sets
{
    Uref
    {
        type    cloud;
        axis    y;
        points  ((4. 4.75 0.01));
    }

    x_by_h_0
    {
        type    face;
        axis    y;
        start   (0. 0 0);
        end     (0. 9.5 0);
        nPoints 100;
