FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
libs ( "libGCEARSM_br_btheta_features.so" );
application     simpleFoam;

startFrom       startTime;//latestTime;//startTime;

startTime       3000;

stopAt          endTime;

endTime         3001;//0.1;

deltaT          1;//5e-7;

writeControl    adjustableRunTime;

writeInterval   1;//300;//0.001;

purgeWrite      0;

writeFormat     ascii;

writePrecision   8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

maxCo         5;

adjustTimeStep  no;

