FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      sample;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


type            sets;
libs            (sampling);

writeControl    onEnd;

interpolationScheme cellPoint;

setFormat       raw;

fields          (k k_Frozen U U_Frozen turbulenceProperties:devReff bijDelta bijDeltaFrozen p);

sets
{
    Uref
    {
        type    cloud;
        axis    y;
        points  ((0 1 0.0));
    }

    x_by_h_0.5
    {
        type    face;
        axis    y;
        start   (0.5 0 0);
        end     (0.5 2 0);
        nPoints 100;
    }
    
    x_by_h_1
    {
        type    face;
        axis    y;
        start   (1. 0 0);
        end     (1. 2 0);
        nPoints 100;
    }
    
    x_by_h_1.5
    {
        type    face;
